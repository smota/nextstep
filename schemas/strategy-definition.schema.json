{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextstep.local/schemas/strategy-definition.schema.json",
  "title": "Nextstep StrategyDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "label", "category", "purpose", "applicability", "phases", "metrics", "guardrails", "source_refs"],
  "properties": {
    "id": { "type": "string", "pattern": "^strategy-definition:[a-z0-9-]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "label": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires", "recommended_when", "avoid_when"],
      "properties": {
        "requires": { "$ref": "#/$defs/stringArray" },
        "recommended_when": { "$ref": "#/$defs/stringArray" },
        "avoid_when": { "$ref": "#/$defs/stringArray" }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "actions", "completion_evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "actions": { "$ref": "#/$defs/stringArrayNonEmpty" },
          "completion_evidence": { "$ref": "#/$defs/stringArray" }
        }
      }
    },
    "metrics": { "$ref": "#/$defs/stringArrayNonEmpty" },
    "guardrails": { "$ref": "#/$defs/stringArray" },
    "source_refs": { "$ref": "#/$defs/stringArray" }
  },
  "$defs": {
    "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "stringArrayNonEmpty": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
